{
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/__pycache__/**": true,
        "**/.mypy_cache/**": true,
        "**/.pytest_cache/**": true,
        "**/.ipynb_checkpoints/**": true,
        "**/runs/**": true,
        "**/outputs/**": true,
        "**/checkpoints/**": true,
        "**/data/**": true,
        "**/docs/**": true,
        "**/miniconda3/**": true,
        "**/.vscode-server/**": true,
        "**/snap/**": true,
        "**/xet/**": true,
        "**/.git/**": true,
        "**/exps/**/result/**": true,
        "**/exps/**/logs/**": true,
        "**/*intermediate_logs.jsonl": true
    },
    "search.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/.venv": true,
        "**/venv": true,
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/.ipynb_checkpoints": true,
        "**/runs": true,
        "**/outputs": true,
        "**/checkpoints": true,
        "**/data": true,
        "**/docs": true,
        "**/miniconda3": true,
        "**/.vscode-server": true,
        "**/snap": true,
        "**/xet": true,
        "**/exps/**/result": true,
        "**/exps/**/logs": true,
        "**/*intermediate_logs.jsonl": true
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ipynb_checkpoints": true
    },
    "python.analysis.indexing": false,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.autoImportCompletions": false,
    "python.analysis.exclude": [
        "**/miniconda3/**",
        "**/.vscode-server/**",
        "**/snap/**",
        "**/xet/**",
        "**/data/**",
        "**/docs/**",
        "**/runs/**",
        "**/outputs/**",
        "**/checkpoints/**",
        "**/exps/**/result/**",
        "**/exps/**/logs/**"
    ],
    "jupyter.askForKernelRestart": false,
    "python.analysis.languageServerMode": "light",
    "git.enabled": false,
    "git.autorefresh": false,
    "search.followSymlinks": false,
    "editor.semanticHighlighting.enabled": false
}
