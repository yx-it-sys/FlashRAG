  <Text name="question_text" value="$question" />

  <Header value="Step-Level Annotation: Iteration 1" />
  <HyperText name="step_html_1" value="$step_html_1" />
  <Text name="step_new_information_prompt_1" value="Question: Does this iteration add new information compared with earlier iterations?" />
  <Choices name="step_new_information_1" toName="step_html_1" choice="single" showInline="true">
    <Choice value="No new information" />
    <Choice value="Partial new information" />
    <Choice value="Clear new information" />
  </Choices>
  <Text name="step_redundant_prompt_1" value="Question: Is this iteration redundant with earlier iterations?" />
  <Choices name="step_redundant_1" toName="step_html_1" choice="single" showInline="true">
    <Choice value="Not redundant" />
    <Choice value="Redundant" />
  </Choices>
  <Text name="step_usefulness_prompt_1" value="Question: Based on the model feedback after retrieval, how useful is this iteration?" />
  <Choices name="step_usefulness_1" toName="step_html_1" choice="single" showInline="true">
    <Choice value="Not useful" />
    <Choice value="Partly useful" />
    <Choice value="Clearly useful" />
  </Choices>
  <TextArea name="step_comment_1" toName="step_html_1" placeholder="Optional notes for iteration 1." editable="true" maxSubmissions="1" />

