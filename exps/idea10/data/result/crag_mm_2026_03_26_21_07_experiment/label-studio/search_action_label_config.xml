  <Text name="mode_text_1" value="Mode: $mode_1" />
  <Text name="query_text_1" value="$query_1" />
  <Choices name="entity_ambiguous_1" toName="query_text_1" choice="single" showInline="true">
    <Choice value="No" />
    <Choice value="Yes" />
  </Choices>
  <Choices name="ambiguity_level_1" toName="query_text_1" choice="single" showInline="true">
    <Choice value="A" />
    <Choice value="B" />
    <Choice value="C" />
    <Choice value="D" />
  </Choices>
  <TextArea name="remark_1" toName="query_text_1" placeholder="Remark for trajectory 1" editable="true" maxSubmissions="1" />

